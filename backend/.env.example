STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_ID=price_your_actual_live_price_id_here
PUBLIC_URL=https://www.grigaeventsfze.com/tickets

EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=user@example.com
EMAIL_SMTP_PASS=supersecret
EMAIL_FROM="GRIGA Events" <tickets@grigaeventsfze.com>

EVENT_NAME="Murima Night – Second Edition"
EVENT_PRICE=150
EVENT_LOCATION="MOUNTAINS RESORT - RAS AL KHAIMAH"

ADMIN_EMAIL=admin@grigaeventsfze.com
ADMIN_PASSWORD_HASH=$2b$10$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_JWT_SECRET=replace-with-long-random-string-actual-secret-here
ADMIN_TOKEN_TTL=1h
ADMIN_BASIC_REALM=GRIGA Admin

TICKET_DATA_DIR=data
TICKET_DATA_FILE=data/tickets.json
TICKET_MEMORY_CAP=5000
TICKET_LOG_LIMIT=2000

# M-Pesa STK Push (Safaricom Daraja - https://developer.safaricom.co.ke)
# MPESA_ENV: sandbox for testing, production when live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_daraja_consumer_key
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret
# GRIGA uses a Buy Goods Till:
#   MPESA_SHORTCODE = shortcode issued with the production Daraja app (4838391);
#                     it pairs with the passkey
#   MPESA_PARTYB    = till number that receives the money (1565010)
#   MPESA_TRANSACTION_TYPE = CustomerBuyGoodsOnline
# For a Paybill instead: set MPESA_SHORTCODE to the paybill, omit MPESA_PARTYB,
# and use CustomerPayBillOnline. (Sandbox testing: shortcode 174379, omit PARTYB,
# CustomerPayBillOnline, with the public sandbox passkey.)
MPESA_SHORTCODE=4838391
MPESA_PARTYB=1565010
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_PASSKEY=your_lipa_na_mpesa_online_passkey
# Public HTTPS URL of this backend (Safaricom posts the payment result here)
MPESA_CALLBACK_BASE_URL=https://api.grigaeventsfze.com
# Origins allowed to call the STK API from the browser (comma-separated), * for any
MPESA_ALLOWED_ORIGINS=https://grigaeventsfze.com,https://www.grigaeventsfze.com
MPESA_ACCOUNT_REF=GRIGA
